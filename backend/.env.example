# ── API Keys (REQUERIDAS) ────────────────────────────────
OPENAI_API_KEY=sk-proj-tu-clave-aqui
GEMINI_API_KEY=tu-clave-gemini-aqui

# ── Base de datos ────────────────────────────────────────
# Driver: psycopg (psycopg3) — NO usar asyncpg
# Para desarrollo local:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/llm_tracker
# Para EasyPanel u otra BD externa:
# DATABASE_URL=postgresql+psycopg://usuario:password@host:puerto/nombre_bd

# ── Modelos (opcional, estos son los defaults) ───────────
OPENAI_MODEL=gpt-4.1
OPENAI_ANALYZER_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.0-flash

# ── App ──────────────────────────────────────────────────
DEBUG=false
