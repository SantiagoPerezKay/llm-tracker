# ── API Keys (REQUERIDAS) ────────────────────────────────
OPENAI_API_KEY=sk-proj-tu-clave-aqui
GEMINI_API_KEY=tu-clave-gemini-aqui

# ── Base de datos ────────────────────────────────────────
# Para desarrollo local (BD corriendo en localhost):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_tracker
# Para Docker (usa el nombre del servicio "db"):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/llm_tracker

# ── Modelos (opcional, estos son los defaults) ───────────
OPENAI_MODEL=gpt-4.1
OPENAI_ANALYZER_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-pro

# ── App ──────────────────────────────────────────────────
DEBUG=false
